# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# archived hero journey sequence — kept locally, never committed
/archive/

# source material, not build inputs: the site builds from public/ alone.
# Kept on disk, never committed — Git keeps every version of a binary forever.
/assets/
/output/

# leftover from the first hero: unreferenced, kept on disk only
/public/hero/hero.mp4
